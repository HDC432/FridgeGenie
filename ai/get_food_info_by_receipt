import { GqlRequestContext } from '../../../../types';
import { getOpenAiClient } from '../../../../shared/open_ai_client';
import * as Sentry from '@sentry/node';
import { PermissionError, ValidationError } from '@ce/errors';
import { LineItem, TransactionCategory } from '@ce/sba-transaction-api-def';

export interface ReceiptInfo {
  vendorName?: string;
  amount?: number;
  description?: string;
  transactedAt?: string;
  categories?: TransactionCategory[];
  lineItems?: LineItem[];
}

export type GetTransactionInfoByReceiptParams = {
  receipt?: string; // base64 encoded image
  receiptUrl?: string; // S3 URL of the image
};

export type GetTransactionInfoByReceiptResult = {
  transactionInfo: ReceiptInfo;
};

const SYSTEM_PROMPT = `You are a receipt analysis expert. Analyze the receipt image and extract key information into a structured format. 
If the image is not a receipt, respond with "NOT_A_RECEIPT". Otherwise, extract information into valid JSON matching this interface:
{
  vendorName?: string;
  amount?: number;
  description?: string; // Generate a description of the transaction in a humurous style
  transactedAt?: string; // The date of the transaction in ISO 8601 format
  /* Vendor's Recommended Budget Categories Association from List (Choose the most relevant one, otherwise use OTHER) (EVERYDAY, ENTERTAINMENT, GIFTS, HEALTH, INSURANCE, EDUCATION, TRAVEL, TRANSPORTATION, UTILITIES, OTHER) */
  categories?: string[];
  /* Optional array of line items from the receipt */
  lineItems?: Array<{
    id: string; // Generate a unique identifier for each item
    name: string; // Name/description of the item
    amount: number; // Price of the individual item
  }>;
}`;

/**
 * GraphQL resolver for extracting information from receipt images using OpenAI Vision, takes
 * in a base64 encoded receipt image and returns a structured JSON object with the receipt information.
 */
export const getTransactionInfoByReceiptResolver = async (
  obj: null,
  args: { params: GetTransactionInfoByReceiptParams },
  context: GqlRequestContext
): Promise<GetTransactionInfoByReceiptResult> => {
  // Check for user authentication
  if (!context.req.user) {
    throw new PermissionError('You are not authenticated');
  }

  // Validate that at least one of receipt or receiptUrl is provided
  if (!args.params.receipt && !args.params.receiptUrl) {
    throw new ValidationError('Either receipt or receiptUrl must be provided');
  }

  try {
    const openai = getOpenAiClient();

    let imageContent: any;
    if (args.params.receiptUrl) {
      imageContent = {
        type: 'image_url',
        image_url: {
          url: args.params.receiptUrl,
        },
      };
    } else if (args.params.receipt) {
      imageContent = {
        type: 'image_url',
        image_url: {
          url: `data:image/jpeg;base64,${args.params.receipt}`,
        },
      };
    }

    const response = await openai.chat.completions.create({
      model: 'gpt-4o-mini',
      messages: [
        {
          role: 'system',
          content: SYSTEM_PROMPT,
        },
        {
          role: 'user',
          content: [imageContent],
        },
      ],
      max_tokens: 1000,
    });

    const result = response.choices[0]?.message?.content;
    if (!result || result === 'NOT_A_RECEIPT') {
      throw new ValidationError(
        'The provided image does not appear to be a receipt'
      );
    }

    try {
      const cleanedResult = result
        .replace(/^```(?:json)?\s*/, '') // Remove opening ```json or ``` at start
        .replace(/\s*```\s*$/, '') // Remove closing ``` at end
        .trim(); // Remove any extra whitespace
      const parsedResult = JSON.parse(cleanedResult) as ReceiptInfo;
      return { transactionInfo: parsedResult };
    } catch (parseError) {
      throw new Error('Failed to parse receipt information');
    }
  } catch (error: unknown) {
    Sentry.captureException(error, {
      extra: {
        userId: context.req.user?.id,
      },
    });
    throw error;
  }
};
